NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
GEMINI_API_KEY=

# NextAuth — generate a long random secret for NEXTAUTH_SECRET
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:9002

# Planner login (required in production). Do not use these values in production.
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=change-me
AUTH_OPERATOR_USERNAME=operator
AUTH_OPERATOR_PASSWORD=change-me
